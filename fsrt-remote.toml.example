# Copy to `fsrt-remote.toml` and keep the local file untracked.

# Atlassian site origin used to resolve cloud_id and access the GraphQL gateway.
site = "https://your-site.atlassian.net"

# Context ARI owner, such as "jira" or "confluence".
product = "jira"

# Used only to disambiguate when multiple app installations are returned.
# Without an override, FSRT prefers "production", then "default", then the first result.
# If multiple installations match, FSRT uses the first result.
# environment_key = "production"

# Authentication material. Do not commit this file.
# Relative paths use the directory where FSRT is run.
[auth]
raw_cookie_file = "./session-cookie.txt"

# Optional settings for `cargo run -p fsrt --features mint_cookie -- dast mint-cookie`.
# The password is read only from ATL_PASSWORD and is never stored in this file.
[cookie]
username = "tester@example.atlassian.net"
# headed = true             # Show Chrome for MFA, bot checks, or consent screens.
# verify_wait_secs = 120    # Time to allow manual completion when headed.
